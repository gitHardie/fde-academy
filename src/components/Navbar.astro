---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/what-is-fde', label: '什么是FDE' },{ href: '/it-career-path', label: 'IT转型路径' },
  { href: '/salary', label: '薪酬报告' },{ href: '/cases', label: '经典案例' },
  { href: '/learning-path', label: '学习路线' },{ href: '/tech-stack', label: '技术栈' },
  { href: '/blog', label: '博客' },
];
---
<nav class="navbar"><div class="nav-container">
  <a href="/" class="nav-logo">AfterAI <span class="dot">·</span> FDE学院</a>
  <button class="nav-toggle" aria-label="菜单"><span></span><span></span><span></span></button>
  <div class="nav-menu"><div class="nav-links">
    {links.map(link => (<a href={link.href} class:list={['nav-link',{active:currentPath.startsWith(link.href)}]}>{link.label}</a>))}
  </div><a href="#community" class="nav-cta">加入社区</a></div>
</div></nav>
<style>
.navbar{position:sticky;top:0;z-index:100;background:rgba(245,247,250,.9);backdrop-filter:blur(12px);border-bottom:1px solid rgba(138,147,166,.15)}
:global(.dark) .navbar{background:rgba(11,11,20,.92)}
.nav-container{max-width:1200px;margin:0 auto;padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;height:64px}
.nav-logo{font-family:'Space Grotesk',sans-serif;font-size:1.2rem;font-weight:700;color:#0B0B14;text-decoration:none}
:global(.dark) .nav-logo{color:#F5F7FA}.nav-logo .dot{color:#FF7A29}
.nav-toggle{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:4px}
.nav-toggle span{display:block;width:24px;height:2px;background:#0B0B14;border-radius:2px}
:global(.dark) .nav-toggle span{background:#F5F7FA}
.nav-menu{display:flex;align-items:center;gap:.5rem}.nav-links{display:flex;gap:.25rem}
.nav-link{padding:.4rem .75rem;border-radius:8px;font-size:.875rem;color:#8A93A6;text-decoration:none;transition:all .2s;font-weight:500}
.nav-link:hover{color:#0B0B14;background:rgba(138,147,166,.1)}
:global(.dark) .nav-link:hover{color:#F5F7FA}.nav-link.active{color:#FF7A29}
.nav-cta{margin-left:.75rem;padding:.5rem 1.25rem;background:#FF7A29;color:#fff!important;border-radius:8px;font-size:.875rem;font-weight:600;text-decoration:none}
.nav-cta:hover{background:#e56a1a}
@media(max-width:768px){
  .nav-toggle{display:flex}.nav-menu{display:none;position:absolute;top:64px;left:0;right:0;flex-direction:column;background:rgba(245,247,250,.98);padding:1rem;border-bottom:1px solid rgba(138,147,166,.15)}
  :global(.dark) .nav-menu{background:rgba(11,11,20,.98)}.nav-menu.open{display:flex}
  .nav-links{flex-direction:column;width:100%}.nav-cta{margin-left:0;text-align:center}
}
</style>
<script>document.querySelector('.nav-toggle')?.addEventListener('click',()=>document.querySelector('.nav-menu')?.classList.toggle('open'));</script>
---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CommunityBox from '../components/CommunityBox.astro';

const categories = [
  {
    title: '模型层',
    icon: '🧠',
    color: '#2DD4FF',
    items: [
      { name: '商用模型', desc: 'GPT-4o / Claude / Gemini / Qwen / DeepSeek' },
      { name: '开源模型', desc: 'Llama 3 / Mistral / Qwen2 / GLM-4' },
      { name: '模型平台', desc: 'OpenAI / 百度千帆 / 阿里百炼 / 火山引擎' },
    ],
  },
  {
    title: '框架层',
    icon: '🔗',
    color: '#FF7A29',
    items: [
      { name: 'Agent框架', desc: 'LangChain / LlamaIndex / Dify / Coze / AutoGen' },
      { name: '向量数据库', desc: 'Milvus / Pinecone / Weaviate / Chroma' },
      { name: '工作流编排', desc: 'Dify / n8n / LangGraph' },
    ],
  },
  {
    title: '部署层',
    icon: '🚀',
    color: '#2DD4FF',
    items: [
      { name: '推理框架', desc: 'vLLM / TGI / Ollama / llama.cpp' },
      { name: '容器编排', desc: 'Docker / Kubernetes' },
      { name: '监控运维', desc: 'LangSmith / LangFuse / Prometheus / Grafana' },
    ],
  },
  {
    title: '应用层',
    icon: '💻',
    color: '#FF7A29',
    items: [
      { name: '后端', desc: 'Python / Node.js / Go' },
      { name: '前端', desc: 'React / Vue / Streamlit' },
      { name: '数据存储', desc: 'PostgreSQL / Redis / Elasticsearch' },
    ],
  },
];
---
<Layout title="技术栈 | AfterAI FDE学院">
  <Navbar />
  <main>
    <section class="page-hero">
      <div class="hero-bg"></div>
      <div class="hero-content">
        <span class="badge">工具箱</span>
        <h1>FDE<span class="gradient-text">技术栈</span></h1>
        <p class="subtitle">前沿部署工程师的完整技术武器库</p>
      </div>
    </section>

    <section class="content-section">
      <div class="content-container">
        {categories.map(cat => (
          <div class="category-block">
            <div class="category-header">
              <span class="cat-icon">{cat.icon}</span>
              <h2 style="color: " + cat.color>{cat.title}</h2>
            </div>
            <div class="tech-grid">
              {cat.items.map(item => (
                <div class="tech-card" style="border-top: 2px solid " + cat.color>
                  <h3>{item.name}</h3>
                  <p>{item.desc}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  
<section class="cms" id="community"><div class="cc"><CommunityBox /></div></section>
</main>
  <Footer />
</Layout>

<style>
  .page-hero {
    position: relative; padding: 6rem 1.5rem 4rem; text-align: center; overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(255,122,41,0.06) 0%, transparent 60%);
  }
  .hero-content { position: relative; z-index: 1; max-width: 700px; margin: 0 auto; }
  .badge {
    display: inline-block; padding: 0.35rem 1rem;
    background: rgba(45,212,255,0.1); color: #2DD4FF;
    border: 1px solid rgba(45,212,255,0.2); border-radius: 20px;
    font-size: 0.8rem; font-weight: 500; margin-bottom: 1.5rem;
  }
  .page-hero h1 { font-size: 3rem; font-weight: 700; color: #F5F7FA; margin-bottom: 1rem; }
  .gradient-text { background: linear-gradient(135deg, #FF7A29, #2DD4FF); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .page-hero .subtitle { color: rgba(245,247,250,0.5); font-size: 1.1rem; }

  .content-section { padding: 2rem 1.5rem 4rem; }
  .content-container { max-width: 896px; margin: 0 auto; }

  .category-block { margin-bottom: 3rem; }
  .category-header {
    display: flex; align-items: center; gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .cat-icon { font-size: 1.5rem; }
  .category-header h2 { font-size: 1.4rem; font-weight: 600; }

  .tech-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .tech-card {
    padding: 1.5rem;
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
    border-radius: 0 0 12px 12px; transition: all 0.3s;
  }
  .tech-card:hover { background: rgba(255,255,255,0.06); transform: translateY(-2px); }
  .tech-card h3 { color: #F5F7FA; font-size: 1rem; margin-bottom: 0.5rem; }
  .tech-card p { color: rgba(245,247,250,0.5); font-size: 0.85rem; line-height: 1.6; }

  @media (max-width: 768px) {
    .page-hero h1 { font-size: 2.2rem; }
    .tech-grid { grid-template-columns: 1fr; }
  }
.cms{padding:2rem 1.5rem 0}.cms .cc{max-width:896px;margin:0 auto}
</style>

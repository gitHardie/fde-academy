---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const cityData = [
  { city: '北京', fde: '50-120万', caio: '120-300万' },
  { city: '上海', fde: '45-110万', caio: '110-280万' },
  { city: '深圳', fde: '45-100万', caio: '100-260万' },
  { city: '广州', fde: '35-80万', caio: '80-200万' },
  { city: '杭州', fde: '40-90万', caio: '90-220万' },
  { city: '成都', fde: '30-70万', caio: '70-160万' },
];

const industryData = [
  { industry: '互联网', fde: '50-120万', caio: '120-300万' },
  { industry: '金融', fde: '45-100万', caio: '100-250万' },
  { industry: '制造', fde: '35-80万', caio: '80-180万' },
  { industry: '咨询', fde: '40-90万', caio: '90-200万' },
];

const overseas = [
  { label: '美国CAIO中位总包', value: '$1.6M', highlight: true },
  { label: 'Base薪酬区间', value: '$250K-$450K', highlight: false },
  { label: '顶级企业总包', value: '$2M+', highlight: true },
];

const demands = [
  { role: 'Agent开发', growth: '+300%', color: '#FF7A29' },
  { role: 'AI产品经理', growth: '+200%', color: '#2DD4FF' },
  { role: 'AI安全', growth: '+180%', color: '#FF7A29' },
  { role: 'AI基础设施', growth: '+150%', color: '#2DD4FF' },
];

const trends = [
  'FDE薪酬继续上涨 15-20%',
  '远程FDE兴起，跨地域协作常态化',
  '证书价值提升 10-20%',
  '自由FDE日薪 5,000-15,000 元',
];
---
<Layout title="薪酬报告 | AfterAI FDE学院">
  <Navbar />
  <main>
    <section class="page-hero">
      <div class="hero-bg"></div>
      <div class="hero-content">
        <span class="badge">2026数据</span>
        <h1>FDE/CAIO <span class="gradient-text">薪酬报告</span></h1>
        <p class="subtitle">AI人才薪酬分析与趋势预测</p>
      </div>
    </section>

    <section class="content-section">
      <div class="content-container">
        <!-- Key Numbers -->
        <h2 class="section-heading">核心数据</h2>
        <div class="big-number-grid">
          <div class="big-number-card">
            <span class="big-number">120万</span>
            <span class="big-label">北京CAIO年薪上限</span>
          </div>
          <div class="big-number-card accent">
            <span class="big-number">$1.6M</span>
            <span class="big-label">美国CAIO中位总包</span>
          </div>
          <div class="big-number-card">
            <span class="big-number">300%</span>
            <span class="big-label">Agent开发需求增长</span>
          </div>
        </div>

        <!-- City Table -->
        <h2 class="section-heading">国内薪酬（按城市）</h2>
        <div class="table-wrapper">
          <table>
            <thead><tr><th>城市</th><th>FDE年薪</th><th>CAIO年薪</th></tr></thead>
            <tbody>
              {cityData.map(r => <tr><td class="city-cell">{r.city}</td><td>{r.fde}</td><td class="high-cell">{r.caio}</td></tr>)}
            </tbody>
          </table>
        </div>

        <!-- Industry Table -->
        <h2 class="section-heading">国内薪酬（按行业）</h2>
        <div class="table-wrapper">
          <table>
            <thead><tr><th>行业</th><th>FDE</th><th>CAIO</th></tr></thead>
            <tbody>
              {industryData.map(r => <tr><td class="city-cell">{r.industry}</td><td>{r.fde}</td><td class="high-cell">{r.caio}</td></tr>)}
            </tbody>
          </table>
        </div>

        <!-- Overseas -->
        <h2 class="section-heading">海外对标</h2>
        <div class="overseas-grid">
          {overseas.map(o => (
            <div class:list={['overseas-card', { 'overseas-highlight': o.highlight }]}>
              <span class="overseas-value">{o.value}</span>
              <span class="overseas-label">{o.label}</span>
            </div>
          ))}
        </div>

        <!-- Hot Demands -->
        <h2 class="section-heading">热门需求增长</h2>
        <div class="demand-grid">
          {demands.map(d => (
            <div class="demand-card">
              <span class="demand-role">{d.role}</span>
              <span class="demand-growth" style="color: " + d.color>{d.growth}</span>
            </div>
          ))}
        </div>

        <!-- Trends -->
        <h2 class="section-heading">趋势预测</h2>
        <div class="trend-list">
          {trends.map((t, i) => (
            <div class="trend-item">
              <span class="trend-num">0{i + 1}</span>
              <span class="trend-text">{t}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero {
    position: relative; padding: 6rem 1.5rem 4rem; text-align: center; overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(255,122,41,0.06) 0%, transparent 60%);
  }
  .hero-content { position: relative; z-index: 1; max-width: 700px; margin: 0 auto; }
  .badge {
    display: inline-block; padding: 0.35rem 1rem;
    background: rgba(45,212,255,0.1); color: #2DD4FF;
    border: 1px solid rgba(45,212,255,0.2); border-radius: 20px;
    font-size: 0.8rem; font-weight: 500; margin-bottom: 1.5rem;
  }
  .page-hero h1 { font-size: 3rem; font-weight: 700; color: #F5F7FA; margin-bottom: 1rem; }
  .gradient-text { background: linear-gradient(135deg, #FF7A29, #2DD4FF); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .page-hero .subtitle { color: rgba(245,247,250,0.5); font-size: 1.1rem; }

  .content-section { padding: 2rem 1.5rem 4rem; }
  .content-container { max-width: 896px; margin: 0 auto; }
  .section-heading {
    font-size: 1.5rem; font-weight: 600; color: #F5F7FA;
    margin: 3rem 0 1.5rem; padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  /* Big Numbers */
  .big-number-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .big-number-card {
    padding: 2rem; text-align: center;
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
    border-radius: 16px;
  }
  .big-number-card.accent { border-color: rgba(255,122,41,0.3); background: rgba(255,122,41,0.05); }
  .big-number {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.5rem; font-weight: 700; color: #2DD4FF;
    margin-bottom: 0.5rem;
  }
  .big-number-card.accent .big-number { color: #FF7A29; }
  .big-label { color: rgba(245,247,250,0.6); font-size: 0.88rem; }

  /* Tables */
  .table-wrapper { overflow-x: auto; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06); }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th, td { padding: 0.85rem 1rem; text-align: left; border-bottom: 1px solid rgba(255,255,255,0.06); }
  th { background: rgba(45,212,255,0.06); color: #2DD4FF; font-weight: 600; }
  td { color: rgba(245,247,250,0.7); }
  .city-cell { color: #F5F7FA; font-weight: 500; }
  .high-cell { color: #FF7A29; font-weight: 500; }

  /* Overseas */
  .overseas-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .overseas-card {
    padding: 1.75rem; text-align: center;
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
    border-radius: 14px;
  }
  .overseas-highlight { border-color: rgba(45,212,255,0.3); background: rgba(45,212,255,0.05); }
  .overseas-value {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2rem; font-weight: 700; color: #FF7A29;
    margin-bottom: 0.5rem;
  }
  .overseas-highlight .overseas-value { color: #2DD4FF; }
  .overseas-label { color: rgba(245,247,250,0.5); font-size: 0.85rem; }

  /* Demands */
  .demand-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .demand-card {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.25rem 1.5rem;
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px; transition: all 0.3s;
  }
  .demand-card:hover { border-color: rgba(255,255,255,0.15); }
  .demand-role { color: #F5F7FA; font-weight: 500; font-size: 1rem; }
  .demand-growth {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.5rem; font-weight: 700;
  }

  /* Trends */
  .trend-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .trend-item {
    display: flex; align-items: center; gap: 1.25rem;
    padding: 1rem 1.5rem;
    background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04);
    border-radius: 10px;
  }
  .trend-num {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.2rem; font-weight: 700; color: rgba(245,247,250,0.15);
    min-width: 36px;
  }
  .trend-text { color: rgba(245,247,250,0.7); font-size: 0.95rem; }

  @media (max-width: 768px) {
    .page-hero h1 { font-size: 2.2rem; }
    .big-number-grid, .overseas-grid { grid-template-columns: 1fr; }
    .demand-grid { grid-template-columns: 1fr; }
    .big-number { font-size: 2rem; }
  }
</style>

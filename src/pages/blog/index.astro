---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CommunityBox from '../../components/CommunityBox.astro';
const posts = [
  { slug:'what-is-fde-the-construction-captain', title:'什么是FDE——企业AI落地的“施工队长”', description:'FDE角色定义、与CIO/CTO/CAIO的关系、借鉴Palantir模式+本土化', date:'2026-06-15', category:'FDE' },
  { slug:'it-career-ai-transformation', title:'IT人的AI转型路径——从CIO到CAIO', description:'CIO三道盲区、两条转型方向、分阶段路线图、能力自测表', date:'2026-06-15', category:'转型' },
  { slug:'2026-fde-caio-salary-report', title:'2026年FDE/CAIO薪酬报告', description:'国内外薪酬数据、热门需求、趋势预测', date:'2026-06-15', category:'薪酬' },
];
const sorted = posts.sort((a,b)=>new Date(b.date)-new Date(a.date));
---
<Layout title="博客 | AfterAI FDE学院"><Navbar /><main class="blog-page"><div class="blog-container">
  <h1>博客</h1><p class="blog-desc">FDE领域的深度文章与行业洞察</p>
  <div class="post-list">{sorted.map(p=>(<article class="post-card"><div class="post-meta"><time>{new Date(p.date).toLocaleDateString('zh-CN')}</time><span class="post-tag">{p.category}</span></div><h2><a href={'/blog/'+p.slug}>{p.title}</a></h2><p>{p.description}</p></article>))}</div>
  <CommunityBox />
</div></main><Footer /></Layout>
<style>
.blog-page{padding:3rem 1.5rem}.blog-container{max-width:768px;margin:0 auto}
.blog-container h1{font-size:2rem;margin-bottom:.5rem}:global(.dark) .blog-container h1{color:#F5F7FA}
.blog-desc{color:#8A93A6;margin-bottom:2rem}
.post-list{display:flex;flex-direction:column;gap:1.5rem}
.post-card{padding:1.5rem;background:#fff;border-radius:12px;border:1px solid rgba(138,147,166,.1);transition:all .2s}
:global(.dark) .post-card{background:#161B26}.post-card:hover{border-color:rgba(255,122,41,.3)}
.post-meta{display:flex;gap:1rem;align-items:center;margin-bottom:.5rem;font-size:.8rem;color:#8A93A6}
.post-tag{background:rgba(255,122,41,.1);color:#FF7A29;padding:.15rem .6rem;border-radius:12px;font-weight:500}
.post-card h2{font-size:1.25rem;margin-bottom:.5rem}.post-card h2 a{color:#0B0B14;text-decoration:none}
:global(.dark) .post-card h2 a{color:#F5F7FA}.post-card h2 a:hover{color:#FF7A29}
.post-card p{color:#8A93A6;font-size:.9rem;line-height:1.6}
</style>
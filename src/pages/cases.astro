---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CommunityBox from '../components/CommunityBox.astro';

const cases = [
  {
    title: '某银行智能风控Agent',
    industry: '金融',
    icon: '🏦',
    summary: '每天10,000+笔交易审核。FDE搭建了多Agent协作系统+RAG管道。',
    metrics: [
      { label: '审核效率提升', value: '4x' },
      { label: '误判率下降', value: '60%' },
      { label: '年省', value: '800万' },
    ],
  },
  {
    title: '某制造企业智能质检',
    industry: '制造',
    icon: '🏭',
    summary: '漏检率3%，8名质检员。FDE驻场梳理17类缺陷，搭建视觉+LLM混合系统。',
    metrics: [
      { label: '漏检率降至', value: '0.3%' },
      { label: 'ROI回正', value: '4个月' },
      { label: '缺陷分类', value: '17类' },
    ],
  },
  {
    title: '某咨询公司知识助手',
    industry: '咨询',
    icon: '💼',
    summary: '100+顾问，报告撰写占35%工时。FDE构建知识库RAG+研究Agent。',
    metrics: [
      { label: '报告时间', value: '-50%' },
      { label: '满意度提升', value: '+15%' },
      { label: '覆盖顾问', value: '100+' },
    ],
  },
];
---
<Layout title="经典案例 | AfterAI FDE学院">
  <Navbar />
  <main>
    <section class="page-hero">
      <div class="hero-bg"></div>
      <div class="hero-content">
        <span class="badge">实战案例</span>
        <h1>企业AI落地<span class="gradient-text">经典案例</span></h1>
        <p class="subtitle">从金融风控到制造质检，FDE如何推动企业AI转型</p>
      </div>
    </section>

    <section class="content-section">
      <div class="content-container">
        <div class="case-list">
          {cases.map((c, i) => (
            <article class="case-card">
              <div class="case-header">
                <div class="case-icon">{c.icon}</div>
                <div>
                  <span class="case-tag">{c.industry}</span>
                  <h2>{c.title}</h2>
                </div>
              </div>
              <p class="case-summary">{c.summary}</p>
              <div class="case-metrics">
                {c.metrics.map(m => (
                  <div class="metric">
                    <span class="metric-value">{m.value}</span>
                    <span class="metric-label">{m.label}</span>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>

        <div id="community">
          <CommunityBox />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero {
    position: relative; padding: 6rem 1.5rem 4rem; text-align: center; overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(45,212,255,0.06) 0%, transparent 60%);
  }
  .hero-content { position: relative; z-index: 1; max-width: 700px; margin: 0 auto; }
  .badge {
    display: inline-block; padding: 0.35rem 1rem;
    background: rgba(255,122,41,0.1); color: #FF7A29;
    border: 1px solid rgba(255,122,41,0.2); border-radius: 20px;
    font-size: 0.8rem; font-weight: 500; margin-bottom: 1.5rem;
  }
  .page-hero h1 { font-size: 3rem; font-weight: 700; color: #F5F7FA; margin-bottom: 1rem; }
  .gradient-text { background: linear-gradient(135deg, #2DD4FF, #FF7A29); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .page-hero .subtitle { color: rgba(245,247,250,0.5); font-size: 1.1rem; }

  .content-section { padding: 2rem 1.5rem 4rem; }
  .content-container { max-width: 896px; margin: 0 auto; }

  .case-list { display: flex; flex-direction: column; gap: 2rem; }
  .case-card {
    padding: 2.5rem;
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
    border-radius: 16px; transition: all 0.3s;
  }
  .case-card:hover { border-color: rgba(45,212,255,0.2); transform: translateY(-2px); }
  .case-header { display: flex; align-items: flex-start; gap: 1.25rem; margin-bottom: 1.25rem; }
  .case-icon { font-size: 2.5rem; }
  .case-tag {
    display: inline-block; padding: 0.2rem 0.7rem;
    background: rgba(45,212,255,0.1); color: #2DD4FF;
    border-radius: 6px; font-size: 0.75rem; font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .case-header h2 { color: #F5F7FA; font-size: 1.4rem; }
  .case-summary { color: rgba(245,247,250,0.6); font-size: 1rem; line-height: 1.7; margin-bottom: 1.5rem; }

  .case-metrics {
    display: flex; gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .metric { text-align: center; flex: 1; }
  .metric-value {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.6rem; font-weight: 700; color: #FF7A29;
    margin-bottom: 0.25rem;
  }
  .metric-label { color: rgba(245,247,250,0.5); font-size: 0.8rem; }

  @media (max-width: 768px) {
    .page-hero h1 { font-size: 2.2rem; }
    .case-card { padding: 1.5rem; }
    .case-metrics { flex-direction: column; gap: 1rem; }
    .case-header { flex-direction: column; }
  }
</style>

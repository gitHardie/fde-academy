---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CommunityBox from '../components/CommunityBox.astro';
const { frontmatter } = Astro.props;
---
<Layout title={frontmatter.title + ' | AfterAI FDE学院'} description={frontmatter.description}>
  <Navbar /><main class="blog-post"><article>
    <header class="post-header">
      <div class="post-meta"><time>{new Date(frontmatter.date).toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric'})}</time><span class="post-tag">{frontmatter.category}</span></div>
      <h1>{frontmatter.title}</h1><p class="post-desc">{frontmatter.description}</p>
    </header>
    <div class="post-content prose"><slot /></div>
    <CommunityBox />
  </article></main><Footer />
</Layout>
<style>
.blog-post{padding:3rem 1.5rem}.post-header{max-width:72ch;margin:0 auto 2rem}
.post-meta{display:flex;gap:1rem;align-items:center;margin-bottom:1rem;font-size:.875rem;color:#8A93A6}
.post-tag{background:rgba(255,122,41,.1);color:#FF7A29;padding:.2rem .7rem;border-radius:12px;font-weight:500;font-size:.8rem}
.post-header h1{font-size:2.25rem;font-weight:700;line-height:1.2;color:#0B0B14;margin-bottom:1rem}
:global(.dark) .post-header h1{color:#F5F7FA}
.post-desc{font-size:1.1rem;color:#8A93A6;line-height:1.6}.post-content{margin-top:2rem}
</style>